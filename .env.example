# 服务端环境变量（可选；AI 接入不在此——每个账户在「设置 → AI」里各自配置）
# 全部可省略：默认值见代码注释。
PORT=3001
# 反代（Caddy）后置 1——取 X-Forwarded-For 真实来源 IP 供限速用；前提：应用端口不直暴公网
# （Docker 部署由 docker-compose.yml 设 =1；本地直连不要设）
TRUST_PROXY=0
# 会话 cookie 强制 Secure=1（https 下自动开，无需设；局域网 http 调试如需强制再置 1）
SESSION_COOKIE_SECURE=
# 运维命令 invite:new 打印完整注册链接用（如 https://sum.lotuses.cn）
BASE_URL=

# ── Docker 部署（docker-compose.yml 读）──
# 容器镜像来源：留空 = 本地/服务器 build（summarizing:local）；
# 设成 ACR 镜像地址 = 生产「CI 出镜像 → 服务器只 pull」形态（见 docs/13 二·1）
# APP_IMAGE=registry.cn-shenzhen.aliyuncs.com/<ns>/summarizing:vX.Y.Z

