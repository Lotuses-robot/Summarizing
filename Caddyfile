# Caddy 反代配置（docs/11 阶段 1 TLS）：自动申请/续期证书（Let's Encrypt）。
# 域名替换为你的（备案域名，如 sum.lotuses.cn）；Caddy 自动 301 http→https。
#
# 部署前确认：
#   - 域名已解析到本机公网 IP；80/443 已开（ACME 需 80 或 443 可达）
#   - app 容器只在 compose 网络内（compose 未给 app 映射端口）——TLS 对外唯一入口是 Caddy
sum.lotuses.cn {
	encode zstd gzip

	# 反代到 app 容器（compose 服务名即主机名）
	reverse_proxy app:3001

	# 访问日志：默认不记 /hook（令牌在路径里，脱敏见 docs/11 R12-2 / 应用侧日志已脱敏）
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}

	# 基础安全头（应用侧也发一份；Caddy 侧兜底）
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
